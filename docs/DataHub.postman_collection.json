{
  "info": {
    "name": "DataHub API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register (Provider)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/register",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\"username\":\"test_provider\",\"password\":\"password123\",\"email\":\"test_p@test.com\",\"role\":\"PROVIDER\"}"
            }
          }
        },
        {
          "name": "Register (Subscriber)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/register",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\"username\":\"test_sub\",\"password\":\"password123\",\"email\":\"test_s@test.com\",\"role\":\"SUBSCRIBER\"}"
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\"username\":\"zhangsan\",\"password\":\"password123\"}"
            }
          }
        }
      ]
    },
    {
      "name": "Assets",
      "item": [
        {
          "name": "Get All Assets",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/assets?page=0&size=10"
          }
        },
        {
          "name": "Search Assets",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/assets?keyword=天气&assetType=DATASET"
          }
        },
        {
          "name": "Get Asset Detail",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/assets/1"
          }
        },
        {
          "name": "Create Asset",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/assets",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"title\":\"测试数据集\",\"assetType\":\"DATASET\",\"description\":\"这是一个测试数据集\",\"endpointUrl\":\"https://api.example.com/test\",\"pricePerMonth\":9.99,\"tags\":\"测试,数据\"}"
            }
          }
        }
      ]
    },
    {
      "name": "Subscriptions",
      "item": [
        {
          "name": "Subscribe Asset",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/subscriptions",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"assetId\":1}"
            }
          }
        },
        {
          "name": "Get My Subscriptions",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/subscriptions/my",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ]
          }
        },
        {
          "name": "Unsubscribe",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/subscriptions/1",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ]
          }
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Get Dashboard Data",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/dashboard"
          }
        }
      ]
    },
    {
      "name": "User",
      "item": [
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/user/profile",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ]
          }
        }
      ]
    }
  ]
}
